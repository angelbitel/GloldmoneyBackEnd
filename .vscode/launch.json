{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug GoldmoneyBackend.Api (Fixed Ports)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/GoldmoneyBackend.Api/bin/Debug/net8.0/GoldmoneyBackend.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/GoldmoneyBackend.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7288;http://localhost:5288"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      }
    }
  ]
}
