# SQL Server SA password (min 8 chars, uppercase, lowercase, number, symbol)
SA_PASSWORD=Your_Strong_SA_Password_123!

# JWT signing key (recommended 32+ characters)
JWT_KEY=Replace_With_A_Strong_Secret_Key_At_Least_32_Chars

# Pepper de las contraseñas del sistema nuevo (32+ caracteres). No cambiarlo ni perderlo:
# las contraseñas guardadas con él dejan de servir.
PASSWORD_PEPPER=Replace_With_A_Random_Secret_At_Least_32_Chars
